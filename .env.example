DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_discord_test_guild_id_here

ADMIN_DASHBOARD_CHANNEL_ID=your_admin_dashboard_channel_id_here
CREATOR_LOG_CHANNEL_ID=your_creator_log_channel_id_here
SUBMISSIONS_LOG_CHANNEL_ID=your_submissions_log_channel_id_here
BOT_ALERTS_CHANNEL_ID=your_bot_alerts_channel_id_here

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google OAuth is handled through Supabase Auth.
# Configure Google Client ID/Secret inside Supabase Auth Providers, not in Railway.
# Production redirect URL expected by this app: https://partnerlinks.app/auth/callback

SHOPIFY_API_KEY=your_shopify_app_client_id_here
SHOPIFY_API_SECRET=your_shopify_app_client_secret_here
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_APP_URL=http://localhost:3000

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DEFAULT_REF_TEMPLATE=https://example.com/?ref={creator_code}
EXPORTS_DIR=exports
LOG_LEVEL=info
